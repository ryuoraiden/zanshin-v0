{
  "manifest_version": 3,
  "name": "Zanshin",
  "version": "0.1.0",
  "description": "Task-locked focus sessions. Finishing the task unlocks the next one.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Zanshin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "pages/options.html",
  "permissions": ["storage", "alarms", "tabs", "declarativeNetRequest", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["content/youtube.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://seek.onlinedegree.iitm.ac.in/*"],
      "js": ["content/seek-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://seek.onlinedegree.iitm.ac.in/*"],
      "js": ["content/picker.js", "content/seek.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://takeuforward.org/*"],
      "js": ["content/picker.js", "content/tuf.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/blocked.html", "pages/blocked.js", "pages/common.js", "lib/*.js", "styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-controls": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Open Zanshin controls (works during a locked lecture)"
    }
  },
  "incognito": "spanning"
}
